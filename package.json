{
  "name": "claude-souvenir",
  "version": "0.3.0",
  "description": "MCP server for searching and browsing Claude Code conversation transcripts",
  "type": "module",
  "bin": {
    "claude-souvenir": "./dist/index.js"
  },
  "files": [
    "dist",
    "vendor/sqlite-vec/bin"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "vendor": "node scripts/vendor-sqlite-vec.mjs",
    "vendor:check": "node scripts/vendor-sqlite-vec.mjs --check",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.5.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "author": {
    "name": "ASymptOmatik"
  },
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "transcript",
    "search",
    "semantic-search",
    "souvenir",
    "memory"
  ]
}
