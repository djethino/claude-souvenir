{
  "souvenir": {
    "command": "node",
    "args": ["${CLAUDE_PLUGIN_ROOT}/dist/index.js"],
    "env": {
      "CLAUDE_PLUGIN_OPTION_EMBEDDING_PROVIDER": "${user_config.embedding_provider}",
      "CLAUDE_PLUGIN_OPTION_EMBEDDING_URL": "${user_config.embedding_url}",
      "CLAUDE_PLUGIN_OPTION_EMBEDDING_MODEL": "${user_config.embedding_model}",
      "CLAUDE_PLUGIN_OPTION_EMBEDDING_DIMENSIONS": "${user_config.embedding_dimensions}",
      "CLAUDE_PLUGIN_OPTION_EMBEDDING_API_KEY": "${user_config.embedding_api_key}",
      "CLAUDE_PLUGIN_OPTION_DB_PATH": "${user_config.db_path}"
    }
  }
}
